+// TestExceptionStackReserve checks that the per-stack OS reserve covers the
+// CONTEXT the kernel pushes when it dispatches an exception on a goroutine
+// stack, and that the stack guard and minimum stack allocation moved with it.
+// See issue 81238.
+func TestExceptionStackReserve(t *testing.T) {
+	kernel32, err := syscall.LoadDLL("kernel32.dll")
+	if err != nil {
+		t.Fatal(err)
+	}
+	initializeContext, err := kernel32.FindProc("InitializeContext")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const contextAllXState = 0x10005f // CONTEXT_ALL | CONTEXT_XSTATE, amd64
+	var n uint32
+	initializeContext.Call(0, contextAllXState, 0, uintptr(unsafe.Pointer(&n)))
+	if runtime.GOARCH != "amd64" {
+		// The flag values above are amd64's; elsewhere just check the
+		// invariants below.
+		n = 0
+	}
+	const exceptionRecord = 152
+	reserve := runtime.StackSystemReserve()
+	t.Logf("InitializeContext(CONTEXT_ALL|CONTEXT_XSTATE) = %d bytes; reserve = %d, guard = %d, minimum stack = %d",
+		n, reserve, runtime.StackGuard(), runtime.StackMinAlloc())
+	if n != 0 && reserve < uintptr(n)+exceptionRecord {
+		t.Errorf("stack reserve %d cannot hold a %d-byte CONTEXT plus a %d-byte EXCEPTION_RECORD", reserve, n, exceptionRecord)
+	}
+	if got := runtime.ExceptionStackReserve(); got != 0 && got != reserve && reserve < got {
+		t.Errorf("reserve %d is below the measured need %d", reserve, got)
+	}
+	if runtime.StackGuard() < reserve {
+		t.Errorf("stack guard %d is below the reserve %d", runtime.StackGuard(), reserve)
+	}
+	if min := runtime.StackMinAlloc(); min <= runtime.StackGuard() {
+		t.Errorf("minimum stack %d leaves no room above the guard %d", min, runtime.StackGuard())
+	}
+}
