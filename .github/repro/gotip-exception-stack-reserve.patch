+// The OS reserve, stack guard and minimum stack allocation in force.
+//
+// They start at their compile-time floors and may be raised once, before any
+// goroutine stack is allocated, by setStackSystemReserve: some systems need
+// more room below a goroutine's stack than stackSystem grants, and how much
+// is only known at run time. Windows is one: the kernel dispatches every
+// exception on the faulting goroutine's own stack, pushing a CONTEXT whose
+// size depends on the CPU's extended register state (see os_windows.go).
+//
+// The linker's nosplit check assumes only the floor, which stays valid
+// because the guard never shrinks below it.
+var (
+	stackSystemReserve uintptr = stackSystem
+	stackGuard         uintptr = stackGuardMin
+	stackMinAlloc      uint32  = fixedStack
+)
+
+// setStackSystemReserve raises the per-stack OS reserve to n bytes, and with
+// it the stack guard and the minimum stack allocation. It must be called from
+// osinit, before the first goroutine stack is allocated, and only raises.
+func setStackSystemReserve(n uintptr) {
+	n = alignUp(n, 16)
+	if n <= stackSystemReserve {
+		return
+	}
+	stackSystemReserve = n
+	stackGuard = stackNosplit + n + abi.StackSmall
+	// Same shape as fixedStack: the smallest power of two that holds the
+	// reserve plus stackMin bytes of Go frames.
+	stackMinAlloc = uint32(round2(int32(stackMin + n)))
+	startingStackSize = stackMinAlloc
+}
