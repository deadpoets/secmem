+// exceptionStackReserve reports how many bytes below a goroutine's stack
+// pointer Windows may write while dispatching an exception on it.
+//
+// Windows has no alternate signal stack. The kernel pushes an EXCEPTION_RECORD
+// and a CONTEXT onto the faulting thread's stack, and ntdll's dispatcher and
+// the runtime's vectored handler (sigtramp) then run on that same stack until
+// sigtrampgo switches to g0. The CONTEXT is not a fixed size: it carries the
+// extended register state (XSTATE) of every CPU feature the OS has enabled,
+// which is under 2 KiB on a typical client CPU but over 11 KiB on Intel Xeons
+// with AMX, whose 8 KiB tile state is laid out even for threads that never
+// use it. stackSystem's 4 KiB floor was sized for the former. See #81238.
+func exceptionStackReserve() uintptr {
+	// Everything the kernel and ntdll put between the faulting SP and the
+	// CONTEXT, plus the frames below it that run before the switch to g0:
+	// EXCEPTION_RECORD (152 bytes on amd64), alignment padding, and the
+	// KiUserExceptionDispatcher, RtlDispatchException, RtlpCallVectoredHandlers
+	// and sigtramp frames. Measured at 1,336 bytes on Windows Server 2025
+	// amd64; rounded up for headroom.
+	const dispatchOverhead = 1536
+
+	// With a nil buffer InitializeContext fails with ERROR_INSUFFICIENT_BUFFER
+	// and stores the size the current CPU's full context needs, XSTATE
+	// included. That is the size the kernel will push. Fall back to the
+	// legacy flags where CONTEXT_XSTATE is not accepted.
+	var n uint32
+	stdcall(_InitializeContext, 0, windows.CONTEXT_ALL|windows.CONTEXT_XSTATE, 0, uintptr(unsafe.Pointer(&n)))
+	if n == 0 {
+		stdcall(_InitializeContext, 0, windows.CONTEXT_ALL, 0, uintptr(unsafe.Pointer(&n)))
+	}
+	if n == 0 {
+		return 0 // keep the compile-time floor
+	}
+	return uintptr(n) + dispatchOverhead
+}
